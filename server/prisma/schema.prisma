generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

enum WorkspaceRole {
    OWNER
    ADMIN
    MANAGER
    MEMBER
}

enum TaskType {
    TASK
    BUG
    FEATURE
    IMPROVEMENT
    OTHER
}

enum ProjectStatus {
    ACTIVE
    PLANNING
    COMPLETED
    ON_HOLD
    CANCELLED
}

enum Priority {
    LOW
    MEDIUM
    HIGH
}

model User {
    id           String   @id @default(uuid())
    name         String
    email        String
    image        String   @default("")
    /// @encrypted
    passwordHash String?
    /// @encrypted
    twoFactorCode    String?
    twoFactorExpires DateTime?
    googleCalendarSync  Boolean @default(false)
    googleCalendarEmail String?
    /// @encrypted
    googleAccessToken   String?
    /// @encrypted
    googleRefreshToken  String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    deletedAt DateTime?

    status          String   @default("ACTIVE") // ACTIVE, PENDING_APPROVAL, REJECTED, SUSPENDED
    isSuperAdmin    Boolean  @default(false)
    rejectionReason String?

    starredChannelIds String[] @default([])

    workspaces      WorkspaceMember[]
    projects        Project[]         @relation("ProjectOwner")
    tasks           Task[]            @relation("TaskAssignee")
    comments        Comment[]
    ownedWorkspaces Workspace[]
    ProjectMember   ProjectMember[]

    sentMessages     Message[] @relation("SentMessages")
    receivedMessages Message[] @relation("ReceivedMessages")
    createdChannels  Channel[] @relation("ChannelCreator")
    joinedChannels   Channel[] @relation("ChannelMembers")
    createdMeetings  Meeting[] @relation("MeetingCreator")
    meetingInvites   MeetingInvite[]
    portfolios       Portfolio[] @relation("PortfolioOwner")
    notifications    Notification[]
    auditLogs        AuditLog[]
    subTeamMemberships SubTeamMember[]
    reactions          MessageReaction[]
    sprintCapacities   SprintCapacity[]
    retroItems         RetroItem[]

    @@index([email])
    @@index([email, deletedAt])
    @@index([status, deletedAt])
    @@index([deletedAt])
}

model Workspace {
    id          String   @id @default(uuid())
    name        String
    slug        String
    description String?
    /// Workspace-specific settings stored as a JSON blob. Refer to validation schema in server codebase.
    settings    Json     @default("{}")
    ownerId     String
    createdAt   DateTime @default(now())
    image_url   String   @default("")
    updatedAt   DateTime @updatedAt
    deletedAt   DateTime?

    approvalStatus String   @default("APPROVED") // APPROVED, PENDING, REJECTED
    requestNotes   String?

    members    WorkspaceMember[]
    projects   Project[]
    portfolios Portfolio[]
    auditLogs  AuditLog[]
    owner      User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    channels   Channel[]
    meetings   Meeting[]
    subTeams   SubTeam[]
    whiteboards Whiteboard[]

    @@index([ownerId])
    @@index([ownerId, deletedAt])
    @@index([approvalStatus, deletedAt])
    @@index([slug])
    @@index([deletedAt])
}

model WorkspaceMember {
    id          String        @id @default(uuid())
    userId      String
    workspaceId String
    message     String        @default("")
    customRole  String        @default("")
    role        WorkspaceRole @default(MEMBER)
    user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

    @@unique([userId, workspaceId])
    @@index([workspaceId, userId, role])
    @@index([userId])
}

model Project {
    id          String          @id @default(uuid())
    name        String
    description String?
    priority    Priority        @default(MEDIUM)
    status      ProjectStatus   @default(ACTIVE)
    start_date  DateTime?
    end_date    DateTime?
    team_lead   String
    workspaceId String
    progress    Int             @default(0)
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt   DateTime?
    /// Stringly-typed stages. Refer to Stage model for the relational representation.
    stages      String          @default("TODO,IN_PROGRESS,DONE")
    members     ProjectMember[]
    milestones  Milestone[]
    portfolios  PortfolioProject[]

    owner     User      @relation("ProjectOwner", fields: [team_lead], references: [id], onDelete: Cascade)
    workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    tasks       Task[]
    meetings    Meeting[]
    subTeams    SubTeam[]
    whiteboards Whiteboard[]
    Stage       Stage[]
    sprints     Sprint[]
    epics       Epic[]

    @@index([workspaceId, status, deletedAt])
    @@index([team_lead, deletedAt])
}

model ProjectMember {
    id        String  @id @default(uuid())
    userId    String
    projectId String
    user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@unique([userId, projectId])
    @@index([projectId, userId])
    @@index([userId])
}

model SubTeam {
    id          String          @id @default(uuid())
    name        String
    description String?
    workspaceId String
    workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    
    projectId   String?
    project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)

    members     SubTeamMember[]

    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt

    @@index([workspaceId])
    @@index([projectId])
}

model SubTeamMember {
    id        String   @id @default(uuid())
    subTeamId String
    userId    String
    subTeam   SubTeam  @relation(fields: [subTeamId], references: [id], onDelete: Cascade)
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([subTeamId, userId])
    @@index([subTeamId, userId])
    @@index([userId])
}

model Stage {
    id        String   @id @default(uuid())
    name      String
    order     Int      @default(0)
    projectId String
    project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
    tasks     Task[]

    @@unique([projectId, name])
    @@index([projectId])
}

model Task {
    id          String     @id @default(uuid())
    projectId   String
    title       String
    description String?
    /// Stringly-typed status. Matches stage relation where appropriate.
    status      String     @default("TODO")
    type        TaskType   @default(TASK)
    priority    Priority   @default(MEDIUM)
    assigneeId  String?
    due_date    DateTime?
    start_date  DateTime?
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt
    deletedAt   DateTime?

    project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
    assignee User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
    comments Comment[]

    dependencies   Task[]    @relation("TaskDependencies")
    blockedTasks   Task[]    @relation("TaskDependencies")

    isRecurring    Boolean   @default(false)
    recurrence     String    @default("NONE")
    lastRecurredAt DateTime?

    milestoneId    String?
    milestone      Milestone? @relation("MilestoneTasks", fields: [milestoneId], references: [id], onDelete: SetNull)
    
    stageId        String?
    stage          Stage?     @relation(fields: [stageId], references: [id], onDelete: SetNull)

    sprintId       String?
    sprint         Sprint?    @relation(fields: [sprintId], references: [id], onDelete: SetNull)
    
    epicId         String?
    epic           Epic?      @relation(fields: [epicId], references: [id], onDelete: SetNull)

    storyPoints    Int?
    version        Int        @default(0)

    @@index([projectId, deletedAt, status, priority])
    @@index([assigneeId, deletedAt, due_date])
    @@index([sprintId, deletedAt])
    @@index([epicId, deletedAt])
    @@index([milestoneId])
    @@index([stageId])
}

model Comment {
    id        String   @id @default(uuid())
    content   String
    userId    String
    taskId    String
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

    @@index([taskId])
    @@index([userId])
}

model Channel {
    id          String    @id @default(uuid())
    name        String
    description String?
    iconUrl     String?
    workspaceId String
    workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    messages    Message[]
    isArchived  Boolean   @default(false)
    isPrivate   Boolean   @default(false)
    creatorId   String?
    creator     User?     @relation("ChannelCreator", fields: [creatorId], references: [id], onDelete: SetNull)
    /// Implicit many-to-many. Consider migration to ChannelMember explicit join table for metadata.
    members     User[]    @relation("ChannelMembers")
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@index([workspaceId])
    @@index([creatorId])
}

model Message {
    id          String    @id @default(uuid())
    content     String
    userId      String
    user        User      @relation("SentMessages", fields: [userId], references: [id], onDelete: Cascade)
    
    channelId   String?
    channel     Channel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)
    
    recipientId String?
    recipient   User?     @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
    
    parentId    String?
    parent      Message?  @relation("MessageThread", fields: [parentId], references: [id], onDelete: SetNull)
    replies     Message[] @relation("MessageThread")
    
    type        String    @default("TEXT") // TEXT, SYSTEM
    contentHash String?
    isPinned    Boolean   @default(false)
    pinnedAt    DateTime?
    isStarred   Boolean   @default(false)
    
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    reactions   MessageReaction[]

    @@index([channelId, createdAt(sort: Desc), id])
    @@index([recipientId, userId, createdAt(sort: Desc)])
    @@index([userId])
    @@index([parentId])
}

model Meeting {
    id          String          @id @default(uuid())
    title       String
    description String?
    agenda      String?
    start_time  DateTime
    end_time    DateTime
    meetingLink String?
    location    String?
    googleEventId String?
    workspaceId String
    projectId   String?
    creatorId   String
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt

    workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    project     Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
    creator     User            @relation("MeetingCreator", fields: [creatorId], references: [id], onDelete: Cascade)
    invites     MeetingInvite[]

    @@index([workspaceId])
    @@index([projectId])
    @@index([creatorId])
}

model MeetingInvite {
    id        String       @id @default(uuid())
    meetingId String
    userId    String
    status    InviteStatus @default(PENDING)
    createdAt DateTime     @default(now())
    updatedAt DateTime     @updatedAt

    meeting   Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
    user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([meetingId, userId])
    @@index([meetingId, userId])
    @@index([userId])
}

enum InviteStatus {
    PENDING
    ACCEPTED
    DECLINED
    TENTATIVE
}

enum MilestoneStatus {
    PLANNED
    IN_PROGRESS
    ACHIEVED
    MISSED
    CANCELLED
}

model Milestone {
    id          String          @id @default(uuid())
    title       String
    description String?
    dueDate     DateTime
    startDate   DateTime?
    status      MilestoneStatus @default(PLANNED)
    color       String          @default("#3B82F6")
    projectId   String
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt

    project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
    tasks       Task[]          @relation("MilestoneTasks")

    @@index([projectId])
}

model Portfolio {
    id          String             @id @default(uuid())
    name        String
    description String?
    color       String             @default("#6366F1")
    icon        String             @default("FolderKanban")
    workspaceId String
    ownerId     String
    status      ProjectStatus      @default(ACTIVE)
    createdAt   DateTime           @default(now())
    updatedAt   DateTime           @updatedAt

    workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    owner       User               @relation("PortfolioOwner", fields: [ownerId], references: [id], onDelete: Cascade)
    projects    PortfolioProject[]

    @@index([workspaceId])
    @@index([ownerId])
}

model PortfolioProject {
    id          String    @id @default(uuid())
    portfolioId String
    projectId   String
    order       Int       @default(0)
    addedAt     DateTime  @default(now())

    portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
    project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@unique([portfolioId, projectId])
    @@index([portfolioId, order])
    @@index([projectId])
}

enum NotificationType {
    TASK_ASSIGNED
    TASK_DUE
    COMMENT_MENTION
    CHAT_MESSAGE
    MEETING_INVITE
    MILESTONE_ALERT
    SYSTEM
}

model Notification {
    id          String           @id @default(uuid())
    userId      String
    workspaceId String?
    type        NotificationType @default(SYSTEM)
    title       String
    content     String?
    entityType  String?          // e.g. "TASK", "CHAT", "MEETING", "MILESTONE"
    entityId    String?
    isRead      Boolean          @default(false)
    isArchived  Boolean          @default(false)
    priority    Priority         @default(MEDIUM)
    createdAt   DateTime         @default(now())
    updatedAt   DateTime         @updatedAt

    user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, isRead, createdAt(sort: Desc)])
}

enum AuditAction {
    CREATE
    UPDATE
    DELETE
    ROLLBACK
    LOGIN
    ROLE_CHANGE
}

enum AuditEntity {
    PROJECT
    TASK
    MILESTONE
    PORTFOLIO
    WORKSPACE
    USER
    MEETING
    SUBTEAM
    WHITEBOARD
}

enum SeverityLevel {
    INFO
    WARNING
    CRITICAL
}

model AuditLog {
    id          String        @id @default(uuid())
    workspaceId String
    userId      String
    action      AuditAction   @default(UPDATE)
    severity    SeverityLevel @default(INFO)
    entityType  AuditEntity   @default(TASK)
    entityId    String?
    entityName  String?
    /// Audit log payload stored as a JSON blob. Refer to audit schema in server codebase.
    details     Json          @default("{}")
    prevHash    String?
    hash        String        @default("GENESIS")
    createdAt   DateTime      @default(now())

    workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([workspaceId, createdAt(sort: Desc)])
    @@index([entityType, entityId])
    @@index([userId])
}

model Whiteboard {
    id            String   @id @default(uuid())
    projectId     String?
    workspaceId   String?
    creatorId     String   @default("")
    isPrivate     Boolean  @default(false)
    isStarred     Boolean  @default(false)
    sharedEmails  Json     @default("[]")
    name          String   @default("Project Board")
    /// Stores the whiteboard pages including node, edge, and drawing canvas data per page.
    pages         Json     @default("[{\"id\":\"page-1\",\"name\":\"Page 1\",\"nodes\":[],\"edges\":[],\"drawings\":[]}]")
    currentPageId String   @default("page-1")
    /// Legacy/viewport storage. In modern code, this only holds the viewport {x, y, zoom} object.
    data          Json     @default("{\"nodes\":[],\"edges\":[],\"viewport\":{\"x\":0,\"y\":0,\"zoom\":1}}")
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
    workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

    @@index([projectId])
    @@index([workspaceId])
}

model MessageReaction {
    id        String   @id @default(uuid())
    messageId String
    userId    String
    emoji     String
    createdAt DateTime @default(now())

    message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([messageId, userId, emoji])
    @@index([messageId])
    @@index([userId])
}

enum SprintStatus {
    PLANNED
    ACTIVE
    COMPLETED
}

model Sprint {
    id           String          @id @default(uuid())
    name         String
    goal         String?
    startDate    DateTime
    endDate      DateTime
    status       SprintStatus    @default(PLANNED)
    projectId    String
    project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
    tasks        Task[]
    capacities   SprintCapacity[]
    retroColumns RetroColumn[]
    createdAt    DateTime        @default(now())
    updatedAt    DateTime        @updatedAt

    @@index([projectId])
}

model Epic {
    id          String   @id @default(uuid())
    name        String
    description String?
    color       String   @default("#8B5CF6")
    projectId   String
    project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
    tasks       Task[]
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([projectId])
}

model SprintCapacity {
    id       String @id @default(uuid())
    sprintId String
    userId   String
    capacity Int    @default(8)
    sprint   Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
    user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([sprintId, userId])
    @@index([sprintId])
    @@index([userId])
}

model RetroColumn {
    id       String      @id @default(uuid())
    sprintId String
    sprint   Sprint      @relation(fields: [sprintId], references: [id], onDelete: Cascade)
    title    String
    items    RetroItem[]

    @@index([sprintId])
}

model RetroItem {
    id       String      @id @default(uuid())
    columnId String
    column   RetroColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
    content  String
    userId   String
    user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    votes    Int         @default(0)
    voters   String[]    @default([])

    @@index([columnId])
}

model OutboxEvent {
    id          String    @id @default(uuid())
    eventType   String
    payload     Json
    status      String    @default("PENDING")
    createdAt   DateTime  @default(now())
    publishedAt DateTime?

    @@index([status, createdAt])
}

model FailedJob {
    id         String   @id @default(uuid())
    jobId      String
    eventName  String
    payload    Json
    error      String
    failedAt   DateTime @default(now())
    isResolved Boolean  @default(false)

    @@index([isResolved, failedAt])
}

model PlatformSetting {
    id        String   @id @default(uuid())
    key       String   @unique
    value     Json     @default("{}")
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([key])
}

model VipInviteCode {
    id          String    @id @default(uuid())
    code        String    @unique
    scope       String    @default("ALL_ACCESS") // ALL_ACCESS, ACCOUNT_ONLY, ORG_ONLY
    maxUses     Int       @default(1)
    usedCount   Int       @default(0)
    expiresAt   DateTime?
    isActive    Boolean   @default(true)
    createdById String
    note        String?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@index([code, isActive])
}

